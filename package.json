{
  "name": "sae",
  "version": "1.0.0",
  "description": "EVM JSON-RPC load balancer with health-aware failover and a live TUI.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "bin": {
    "sae": "bin/sae.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "os": ["darwin", "linux", "win32"],
  "files": ["dist", "bin", "default.config.json", "sae.schema.json"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "start": "node bin/sae.mjs",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch dist/index.js)",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/tests/**/*.test.js\"",
    "lint": "oxlint src tests",
    "format": "oxfmt src tests",
    "format:check": "oxfmt --check src tests",
    "release": "release-it"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^11.0.1",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "release-it": "^20.2.1",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@10.0.0"
}
